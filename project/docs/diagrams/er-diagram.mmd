    uuid id PK
    uuid user_id
    string status
    int total_cents
    datetime created_at
  }
  ORDER_ITEMS {
    uuid id PK
    uuid order_id FK
    uuid book_id
    string title_snapshot
    int unit_price_cents
    int quantity
