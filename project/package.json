{
  "name": "online-bookstore",
  "private": true,
  "version": "0.1.0",
  "description": "Programming 5 final project: online bookstore built from 5 microservices",
  "type": "module",
  "workspaces": [
    "gateway",
    "services/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d rabbitmq",
    "infra:down": "docker compose down",
    "dev:all": "concurrently -n user,catalog,cart,order,notif,gateway -c blue,green,yellow,cyan,red,magenta \"npm:dev:user\" \"npm:dev:catalog\" \"npm:dev:cart\" \"npm:dev:order\" \"npm:dev:notification\" \"npm:dev:gateway\"",
    "dev:gateway": "npm run dev -w gateway",
    "dev:user": "npm run dev -w services/user-service",
    "dev:catalog": "npm run dev -w services/catalog-service",
    "dev:cart": "npm run dev -w services/cart-service",
    "dev:order": "npm run dev -w services/order-service",
    "dev:notification": "npm run dev -w services/notification-service",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
